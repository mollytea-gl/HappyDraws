    codePlaceholder:"请输入验证码", getCode:"获取验证码", loginBtn:"登录", loginHint:"",
    quotaLabel:"剩余", quotaInfo:"免费2次/上限10次", freePerDay:"每日免费 2 次", maxPerDay:"每日上限 10 次",
    winRateNote:"胜率约 30%", drawBtn:"开始抽奖", shareBtn:"好友助力+1次", reloginBtn:"退出重登",
    simulateAssist:"模拟助力 +1", records:"今日记录", noRecord:"还没有抽奖记录",
    rules:"活动规则", rulesBtn:"规则", prizesBtn:"奖品",
