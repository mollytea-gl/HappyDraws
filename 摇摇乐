    pMerch:"周边兑换券", pFreeCup:"单杯免单券", pHalfOff:"整单5折券",
    pTenOff:"整单9折券", p2yuan:"2元代金券", p15Off:"整单85折券",
    win:"恭喜获得！", lose:"恭喜获得！", claim:"立即领取", claimed:"已领取",
    copyLink:"复制链接", linkCopied:"链接已复制，去发给好友吧",
    shareTitle:"分享给好友助力", shareSub:"复制下方链接，发给好友即可助力 +1 次", shareCopyBtn:"复制链接", shareTip:"若自动复制失败，请长按上方链接手动复制",
    assistOk:"好友助力成功，次数 +1", noChance:"今日次数已用完",
    codeSent:"验证码已发送（演示）：", invalidPhone:"请输入正确的手机号",
    enterCode:"请先获取验证码", winPool:"进入胜利奖池", losePool:"进入失败奖池",
    claimedToast:"已标记为领取"
  },
  en:{
    appTitle:"Happy Spin", appSubtitle:"Spin & win daily rewards", chooseLang:"Choose language",
    loginTitle:"Phone Login", loginSub:"Verify to join the draw", phonePlaceholder:"Enter phone number",
    codePlaceholder:"Enter code", getCode:"Get Code", loginBtn:"Login", loginHint:"",
    quotaLabel:"Left", quotaInfo:"2 free / Max 10", freePerDay:"2 free draws/day", maxPerDay:"Max 10/day",
    winRateNote:"~30% win rate", drawBtn:"SPIN", shareBtn:"Friend Assist +1", reloginBtn:"Logout",
    simulateAssist:"Assist +1", records:"Today's Draws", noRecord:"No draws yet",
    rules:"Rules", rulesBtn:"Rules", prizesBtn:"Prizes",
    rule1:"2 free draws per day", rule2:"Share & get assists, +1 each",
    rule3:"Max 10 draws per day", rule4:"3 matching cards = win pool",
    rule5:"Tap 'Claim' after winning to redeem",
    actSub:"Spin for surprises daily",
    winPoolTitle:"🏆 Win Pool (3 match)", losePoolTitle:"🎁 Lose Pool (no match)",
    pMerch:"Merch Voucher", pFreeCup:"Free Cup", pHalfOff:"50% Off",
    pTenOff:"10% Off", p2yuan:"¥2 Voucher", p15Off:"15% Off",
    win:"Congratulations!", lose:"Congratulations!", claim:"Claim Now", claimed:"Claimed",
    copyLink:"Copy Link", linkCopied:"Link copied!",
    shareTitle:"Share with Friends", shareSub:"Copy the link below and send to a friend for +1 draw", shareCopyBtn:"Copy Link", shareTip:"If auto-copy fails, long-press the link to copy manually",
    assistOk:"Assist success, +1 draw", noChance:"Out of draws today",
    codeSent:"Code sent (demo): ", invalidPhone:"Enter a valid phone",
    enterCode:"Get a code first", winPool:"Win Pool", losePool:"Lose Pool",
    claimedToast:"Marked as claimed"
  }
};

/* data:image/jpeg;base64, ~ data:image/jpeg;base64, replaced with base64 JPEG of original product photos */
const SYMBOLS = ["data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,"];
const WIN_RATE=0.30, FREE=2, MAX=10;
const WIN_POOL=[
  {key:"merch",zh:"周边兑换券",en:"Merch Voucher",ico:"🎁",w:1},
  {key:"freeCup",zh:"单杯免单券",en:"Free Cup",ico:"🥤",w:1.5},
  {key:"halfOff",zh:"整单5折券",en:"50% Off",ico:"🏷️",w:1.2}
];
const LOSE_POOL=[
  {key:"tenOff",zh:"整单9折券",en:"10% Off",ico:"🎟️",w:1.4},
  {key:"2yuan",zh:"2元代金券",en:"¥2 Voucher",ico:"💰",w:1.8},
  {key:"15Off",zh:"整单85折券",en:"15% Off",ico:"🎫",w:1.3}
];

let lang="zh", phone="", spinning=false, lastPrize=null, lastOutcome=null;

/* safe storage */
const _mem={};
function lsGet(k){try{return localStorage.getItem(k)}catch(e){return k in _mem?_mem[k]:null}}
function lsSet(k,v){try{localStorage.setItem(k,v)}catch(e){_mem[k]=v}}

function today(){return new Date().toISOString().slice(0,10)}
function loadQuota(){let q;try{q=JSON.parse(lsGet("molly_quota"))}catch(e){}if(!q||q.date!==today())q={date:today(),bonus:0,totalUsed:0};return q}
function saveQuota(q){lsSet("molly_quota",JSON.stringify(q))}
function available(q){return Math.max(0,Math.min(MAX,FREE+q.bonus)-q.totalUsed)}

/* reels */
const reels=[0,1,2].map(i=>document.getElementById("reel"+i));
function buildReels(){
  reels.forEach((reel,i)=>{
    const strip=document.getElementById("strip"+i);
    const cell=reel.clientHeight||100;
    let h="";
    for(let k=0;k<180;k++)h+='<img src="'+SYMBOLS[k%6]+'" style="height:'+cell+'px">';
    strip.innerHTML=h;
    const s=Math.floor(Math.random()*6);
    strip.style.transition="none";
    strip.style.transform="translateY("+(-s*cell)+"px)";
  });
}
function spinTo(targets){
  reels.forEach((reel,i)=>{
    const strip=document.getElementById("strip"+i);
    const cell=reel.clientHeight||100;
    strip.style.transition="none";
    strip.style.transform="translateY("+(-targets[i]*cell)+"px)";
    void strip.offsetHeight;
    reel.classList.add("spinning");
    const dur=(1.3+i*0.32);
    strip.style.transition="transform "+dur+"s cubic-bezier(.12,.78,.18,1)";
    const far=90+targets[i];
    strip.style.transform="translateY("+(-far*cell)+"px)";
  });
  return (1.3+2*0.32)*1000+100;
}

/* i18n */
function applyI18n(){
  document.documentElement.lang=lang;
  document.querySelectorAll("[data-i18n]").forEach(el=>el.textContent=I18N[lang][el.dataset.i18n]);
  document.querySelectorAll("[data-i18n-ph]").forEach(el=>el.placeholder=I18N[lang][el.dataset.i18nPh]);
  const lt=document.getElementById("langToggle"); if(lt)lt.textContent=lang==="zh"?"EN":"中";
  document.querySelectorAll(".lang-btn").forEach(x=>x.classList.toggle("sel",x.dataset.lang===lang));
  if(lastOutcome){
    document.getElementById("modalBig").textContent=t(lastOutcome?"win":"lose");
  }
}
function t(k){return I18N[lang][k]}

/* toast */
let toastTimer;
function toast(msg){const el=document.getElementById("toast");el.textContent=msg;el.classList.add("show");clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove("show"),1800)}

/* nav */
function show(id){document.querySelectorAll(".screen").forEach(s=>s.classList.remove("active"));document.getElementById(id).classList.add("active")}

/* entry */
document.querySelectorAll(".lang-btn").forEach(b=>{
  b.onclick=()=>{lang=b.dataset.lang;document.querySelectorAll(".lang-btn").forEach(x=>x.classList.remove("sel"));b.classList.add("sel");setTimeout(()=>{applyI18n();show("screen-login");},280)};
});
/* in-app language switch (activity page) */
document.getElementById("langToggle").onclick=()=>{lang=lang==="zh"?"en":"zh";applyI18n();};
/* re-login: clear session and return to login screen */
document.getElementById("reloginBtn").onclick=()=>{
  phone="";document.getElementById("phone").value="";document.getElementById("code").value="";
  const dc=document.getElementById("devCode");if(dc)dc.style.display="none";
  show("screen-login");applyI18n();
};

/* login */
document.getElementById("getCode").onclick=()=>{
  const ph=document.getElementById("phone").value.trim();
  if(!/^1\d{10}$/.test(ph)){toast(t("invalidPhone"));return;}
  const c=String(Math.floor(100000+Math.random()*900000));
  window.__demoCode=c;
  const dc=document.getElementById("devCode");dc.style.display="block";dc.textContent=t("codeSent")+c;
  toast(t("codeSent")+c);
};
document.getElementById("loginBtn").onclick=()=>{
  const ph=document.getElementById("phone").value.trim();const code=document.getElementById("code").value.trim();
  if(!/^1\d{10}$/.test(ph)){toast(t("invalidPhone"));return;}
  if(!code){toast(t("enterCode"));return;}
  phone=ph;
  renderQuota();renderRecords();applyI18n();show("screen-activity");
  requestAnimationFrame(()=>buildReels());
};

/* quota */
function renderQuota(){
  const q=loadQuota();const av=available(q);
  const qn=document.getElementById("quotaNum");if(qn)qn.textContent=av;
  const btn=document.getElementById("drawBtn");
  const badge=document.getElementById("drawBadge");
  if(btn){if(av<=0){btn.style.filter="grayscale(.5)";btn.style.opacity=".6";btn.disabled=true}else{btn.style.filter="";btn.style.opacity="1";btn.disabled=false}}
  if(badge)badge.textContent=av+"次";

}

/* draw */
function weightedPick(pool){const tot=pool.reduce((s,p)=>s+p.w,0);let r=Math.random()*tot;for(const p of pool){if((r-=p.w)<0)return p}return pool[0]}
document.getElementById("drawBtn").onclick=()=>{
  if(spinning)return;
  const q=loadQuota();if(available(q)<=0){toast(t("noChance"));return;}
  spinning=true;q.totalUsed++;saveQuota(q);renderQuota();
  const win=Math.random()<WIN_RATE;
  let sym;if(win){const s=Math.floor(Math.random()*6);sym=[s,s,s]}
  else{const a=Math.floor(Math.random()*6);let b=(a+1+Math.floor(Math.random()*5))%6;sym=[a,b,a]}
  const prize=weightedPick(win?WIN_POOL:LOSE_POOL);
  lastOutcome=win?"win":"lose";lastPrize=prize;
  const dur=spinTo(sym);
  setTimeout(()=>{
    reels.forEach(r=>r.classList.remove("spinning"));spinning=false;
    pushRecord(win,prize,sym);
    setTimeout(()=>openPrize(win,prize),1400);
  },dur);
};

/* records */
function getRecords(){let r;try{r=JSON.parse(lsGet("molly_records"))}catch(e){}return Array.isArray(r)?r:[]}
function pushRecord(win,prize,sym){const r=getRecords();r.unshift({win,key:prize.key,icons:sym,time:Date.now()});lsSet("molly_records",JSON.stringify(r.slice(0,20)));renderRecords()}
function renderRecords(){
  const list=document.getElementById("recList");const r=getRecords();
  if(!r.length){list.innerHTML='<div class="empty">'+t("noRecord")+'</div>';return;}
  list.innerHTML=r.map(it=>{
    const p=(WIN_POOL.concat(LOSE_POOL)).find(x=>x.key===it.key);
    const nm=lang==="zh"?p.zh:p.en;
    const imgs=it.icons.map(i=>'<img src="'+SYMBOLS[i]+'">').join("");
    return '<div class="rec"><div class="syms">'+imgs+'</div><span class="nm">'+nm+'</span><span class="tag">'+(it.win?'🏆':'🎁')+'</span></div>';
  }).join("");
}

/* modal */
function openPrize(win,prize){
  const head=document.getElementById("modalHead"),coupon=document.getElementById("coupon");
  head.className="modal-head "+(win?"win":"lose");
  coupon.className="coupon "+(win?"":"lose");
  document.getElementById("modalBig").textContent=t(win?"win":"lose");
  document.getElementById("couponIco").textContent=prize.ico;
  document.getElementById("couponTitle").textContent=lang==="zh"?prize.zh:prize.en;
  document.getElementById("couponSub").textContent=win?t("winPool"):t("losePool");
  const cb=document.getElementById("claimBtn");cb.className="";cb.textContent=t("claim");cb.disabled=false;
  cb.onclick=()=>{window.open("https://example.com/redeem?prize="+prize.key,"_blank");cb.className="claimed";cb.textContent=t("claimed");cb.disabled=true;toast(t("claimedToast"));setTimeout(()=>document.getElementById("prizeMask").classList.remove("show"),900)};
  document.getElementById("prizeMask").classList.add("show");
}
document.getElementById("prizeMask").onclick=e=>{if(e.target.id==="prizeMask")e.target.classList.remove("show")};
document.getElementById("modalClose").onclick=()=>document.getElementById("prizeMask").classList.remove("show");

/* share / assist */
function copyText(text){
  return new Promise((resolve,reject)=>{
    if(navigator.clipboard && window.isSecureContext && navigator.clipboard.writeText){
      navigator.clipboard.writeText(text).then(resolve).catch(()=>execCopy(text,resolve,reject));
    }else{
      execCopy(text,resolve,reject);
    }
  });
}
function execCopy(text,resolve,reject){
  try{
    const ta=document.createElement("textarea");
    ta.value=text;ta.setAttribute("readonly","");
    ta.style.cssText="position:fixed;top:0;left:0;width:1px;height:1px;opacity:0;";
    document.body.appendChild(ta);ta.focus();ta.select();
    ta.setSelectionRange(0,text.length);
    const ok=document.execCommand("copy");
    document.body.removeChild(ta);
    ok?resolve():reject(new Error("execCommand failed"));
  }catch(e){reject(e)}
}
function buildShareLink(){
  let base="";try{base=location.origin||""}catch(e){}
  if(!base||base==="null"||base==="undefined")base="https://mollytea.example.com/activity";
  const code=Math.random().toString(36).slice(2,8).toUpperCase();
  return base+(location.pathname||"/spin")+"?ref="+code;
}
function openShare(){
  const link=buildShareLink();
  const inp=document.getElementById("shareLink");
  inp.value=link;
  const btn=document.getElementById("shareCopyBtn");
  btn.textContent=t("shareCopyBtn"); btn.classList.remove("copied");
  document.getElementById("shareMask").classList.add("show");
  setTimeout(()=>{inp.focus();inp.select();},50);
  /* attempt silent copy; link is always visible & selected as a fallback */
  copyText(link).then(()=>{
    btn.textContent="✓ "+t("linkCopied"); btn.classList.add("copied");
  }).catch(()=>{});
}
document.getElementById("shareBtn").onclick=openShare;
document.getElementById("shareCopyBtn").onclick=()=>{
  const link=document.getElementById("shareLink").value;
  copyText(link).then(()=>{
    const btn=document.getElementById("shareCopyBtn");
    btn.textContent="✓ "+t("linkCopied"); btn.classList.add("copied");
  }).catch(()=>{
    const inp=document.getElementById("shareLink");
    inp.focus();inp.select();
    toast(t("shareTip"));
  });
};
document.getElementById("shareClose").onclick=()=>document.getElementById("shareMask").classList.remove("show");
document.getElementById("shareMask").onclick=e=>{if(e.target.id==="shareMask")e.target.classList.remove("show")};
document.getElementById("assistBtn").onclick=()=>{const q=loadQuota();q.bonus++;saveQuota(q);renderQuota();toast(t("assistOk"))};

/* init */
applyI18n();

/* floating download button */
(function(){
  var btn=document.getElementById("floatDl");
  if(!btn)return;
  try{
    var html=document.documentElement.outerHTML;
    var blob=new Blob([html],{type:"text/html;charset=utf-8"});
    btn.href=URL.createObjectURL(blob);
  }catch(e){
    btn.href="#";
    btn.onclick=function(){alert("下载失败，请用 Ctrl+S (Mac: Cmd+S) 保存页面");return false};
  }
})();
</script></body></html>
