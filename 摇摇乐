<html lang="zh"><head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>MOLLY TEA · 欢喜摇摇乐</title>
<style>
  :root{
    --pink-light:#fceef5; --pink-soft:#f9d5e5; --machine:#fbe5ee; --machine-border:#f5b8cc;
    --accent:#fdbbcb; --accent-dark:#e85d80; --gold-soft:#ffe066;
    --text:#3a2e33; --muted:#8a7a82; --white:#fff;
    --shadow:0 8px 28px rgba(232,93,128,.14);
    --btn-pink:#f06a92; --btn-pink-deep:#e85d80;
  }
  *{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
  html,body{height:100%;overflow-x:hidden}
  body{
    font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;
    background:linear-gradient(180deg,#fceef5 0%,#fdf5f8 30%,#fef0f4 70%,#fbe5ee 100%);
    /* bokeh dots */
    background-image:
      radial-gradient(circle at 15% 20%, rgba(253,187,203,.15) 0%, transparent 50%),
      radial-gradient(circle at 80% 35%, rgba(232,93,128,.10) 0%, transparent 45%),
      radial-gradient(circle at 40% 75%, rgba(253,187,203,.12) 0%, transparent 40%);
    background-attachment:fixed;
  }
  #app{max-width:420px;margin:0 auto;padding:16px 14px 32px;position:relative}

  .screen{display:none;animation:fade .35s ease}
  .screen.active{display:block}
  @keyframes fade{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
  @keyframes bounce{0%,100%{transform:scale(1)}50%{transform:scale(1.04)}}
  @keyframes twinkle{0%,100%{opacity:1}50%{opacity:.45}}

  /* ===== ENTRY ===== */
  .entry-wrap{text-align:center;padding:60px 20px;display:flex;flex-direction:column;align-items:center;gap:24px;min-height:100vh}
  .brand-logo{height:38px}
  .entry-title{font-size:32px;font-weight:900;color:var(--accent-dark);letter-spacing:2px;text-shadow:0 2px 8px rgba(253,187,203,.3)}
  .entry-sub{font-size:14px;color:var(--muted);margin-top:4px}
  .lang-label{font-size:13px;color:var(--muted);margin-bottom:14px}
  .lang-row{display:flex;gap:14px;width:100%;max-width:300px}
  .lang-btn{
    flex:1;min-width:0;padding:16px 8px;border-radius:20px;
    border:2.5px solid var(--machine-border);background:var(--white);
    font-size:17px;font-weight:700;color:var(--text);
    cursor:pointer;transition:.25s;
    text-align:center;line-height:1.2;
    display:inline-flex;align-items:center;justify-content:center;
    box-shadow:0 3px 10px rgba(232,93,128,.12);
  }
  .lang-btn:active{transform:scale(.95)}
  .lang-btn.sel{
    background:linear-gradient(135deg,var(--accent),var(--accent-dark));
    border-color:var(--accent-dark);color:#fff;
    box-shadow:0 6px 22px rgba(232,93,128,.28);
  }

  /* ===== LOGIN ===== */
  .login-wrap{display:flex;justify-content:center;align-items:center;min-height:100vh;padding:20px}
  .login-card{background:var(--white);border-radius:24px;padding:28px 24px;width:100%;max-width:340px;box-shadow:var(--shadow)}
  .login-logo{display:block;margin:0 auto 16px;height:34px}
  .login-title{font-size:22px;font-weight:800;color:var(--accent-dark);text-align:center}
  .login-sub{text-align:center;color:var(--muted);font-size:13px;margin:4px 0 20px}
  .field{display:flex;align-items:center;gap:8px;background:#fdf6f8;border:1.5px solid #f3dde4;border-radius:14px;padding:12px 14px;margin-bottom:12px}
  .field input{flex:1;border:none;background:transparent;outline:none;font-size:16px;color:var(--text);min-width:0}
  .field .code-btn{white-space:nowrap;color:var(--accent-dark);font-weight:700;font-size:14px;cursor:pointer;flex-shrink:0}
  .primary-btn{width:100%;padding:14px;border:none;border-radius:16px;background:linear-gradient(135deg,var(--accent),var(--accent-dark));color:#fff;font-size:17px;font-weight:800;cursor:pointer;box-shadow:0 6px 20px rgba(232,93,128,.25);transition:.15s}
  .primary-btn:active{transform:scale(.97)}
  .primary-btn:disabled{opacity:.5}
  .hint{text-align:center;font-size:12px;color:var(--muted);margin-top:12px;min-height:16px}
  .dev-code{background:#fff9e6;color:#b8860b;border-radius:10px;padding:8px 10px;font-size:13px;text-align:center;margin-top:10px}

  /* ===== ACTIVITY HEADER ===== */
  .act-header{text-align:center;padding:8px 0 4px;position:relative}
  .act-header .top-row{display:flex;align-items:center;justify-content:center;gap:8px;margin-bottom:6px}
  .act-header .brand-svg{height:26px;width:130px}
  .act-header .brand-txt{font-size:13px;font-weight:700;color:var(--muted);letter-spacing:3px}
  .act-title{font-size:28px;font-weight:900;color:var(--accent-dark);letter-spacing:3px;text-shadow:0 2px 10px rgba(232,93,128,.2)}
  .act-sub{font-size:12px;color:var(--muted);margin-top:2px}
  .header-actions{position:absolute;top:34px;right:0;display:flex;flex-wrap:wrap;justify-content:flex-end;gap:6px;max-width:62%}
  .header-actions button{padding:5px 10px;border-radius:18px;border:1.5px solid var(--machine-border);background:var(--white);font-size:12px;font-weight:700;color:var(--btn-pink-deep);cursor:pointer;line-height:1.2;white-space:nowrap}
  .header-actions button.accent{background:linear-gradient(135deg,var(--btn-pink),var(--btn-pink-deep));color:#fff;border-color:transparent}

  /* ===== QUOTA BADGE (compact) ===== */
  .quota-bar{display:flex;align-items:center;justify-content:center;gap:10px;margin:10px 0 14px}
  .quota-pill{
    display:inline-flex;align-items:center;gap:6px;
    background:linear-gradient(135deg,var(--btn-pink),var(--btn-pink-deep));
    color:#fff;padding:6px 16px;border-radius:20px;font-size:13px;font-weight:700;
    box-shadow:0 3px 12px rgba(232,93,128,.25);
  }
  .quota-pill .num{font-size:18px;font-weight:900}
  .quota-info{font-size:11px;color:var(--muted)}

  /* ===== SLOT MACHINE (reference style) ===== */
  .slot-area{display:flex;flex-direction:column;align-items:center;margin:8px 0 16px}
  .slot-machine{
    position:relative;background:linear-gradient(180deg,var(--machine) 0%,#fef0f5 100%);
    border-radius:28px;border:4px solid var(--machine-border);
    padding:18px 16px 22px;
    width:100%;max-width:340px;
    box-shadow:
      0 12px 36px rgba(232,93,128,.18),
      inset 0 2px 0 rgba(255,255,255,.6);
  }
  /* decorative bulbs around machine frame */
  .bulb{position:absolute;width:10px;height:10px;border-radius:50%;z-index:2}
  .bulb.gold{background:radial-gradient(circle at 35% 35%,#fff,var(--gold-soft));box-shadow:0 1px 4px rgba(255,200,0,.4)}
  .bulb.white{background:radial-gradient(circle at 35% 35%,#fff,#e8eef2);box-shadow:0 1px 4px rgba(180,200,210,.3)}
  /* top row */
  .bulb.b1{top:7px;left:18%}.bulb.b2{top:7px;left:34%}.bulb.b3{top:7px;left:50%}.bulb.b4{top:7px;left:66%}.bulb.b5{top:7px;left:82%}
  /* bottom row */
  .bulb.b6{bottom:7px;left:14%}.bulb.b7{bottom:7px;left:30%}.bulb.b8{bottom:7px;left:46%}.bulb.b9{bottom:7px;left:62%}.bulb.b10{bottom:7px;left:78%}
  /* left side */
  .bulb.b11{top:22%;left:7px}.bulb.b12{top:42%;left:7px}.bulb.b13{top:62%;left:7px}
  /* right side */
  .bulb.b14{top:22%;right:7px}.bulb.b15{top:42%;right:7px}.bulb.b16{top:62%;right:7px}

  .reels{display:flex;gap:8px;justify-content:center;border-radius:18px;padding:10px 8px}
  .reel{flex:1;aspect-ratio:.85/1;border-radius:14px;overflow:hidden;position:relative}
  .reel .strip{display:flex;flex-direction:column;will-change:transform}
  .reel .strip img{width:100%;height:100%;object-fit:cover;display:block}
  .reel.spinning .strip{filter:blur(1.2px)}

  /* ===== ACTION BUTTONS ===== */
  .action-row{display:flex;gap:12px;width:100%;max-width:340px;margin:0 auto 14px}
  .action-row button{
    padding:13px;border-radius:16px;font-size:15px;font-weight:800;cursor:pointer;
    transition:.15s;border:none;
  }
  .action-row button:active{transform:scale(.96)}
  .btn-secondary{background:var(--white);color:var(--btn-pink-deep);box-shadow:0 3px 12px rgba(232,93,128,.15);border:1.5px solid var(--machine-border)!important;flex:1;white-space:nowrap}
  .btn-draw{
    background:linear-gradient(135deg,var(--btn-pink),var(--btn-pink-deep));color:#fff;
    box-shadow:0 6px 20px rgba(232,93,128,.3);
    position:relative;width:100%
  }
  .draw-wrap{position:relative;display:inline-flex;flex:2.6}
  .draw-badge{
    position:absolute;top:-8px;right:-4px;background:linear-gradient(135deg,#ff9a56,#ff6b35);
    color:#fff;font-size:10px;font-weight:800;padding:2px 7px;border-radius:10px;
    box-shadow:0 2px 6px rgba(255,107,53,.35)
  }

  /* ===== PANELS ===== */
  .panel{background:var(--white);border-radius:18px;padding:14px 16px;margin-bottom:12px;box-shadow:0 4px 16px rgba(232,93,128,.08)}
  .panel h3{font-size:14px;color:var(--text);margin-bottom:8px;display:flex;align-items:center;gap:6px;font-weight:800}
  .rec{display:flex;align-items:center;gap:8px;padding:7px 0;border-bottom:1px dashed #e8ecf0;font-size:13px}
  .rec:last-child{border-bottom:none}
  .rec .syms{display:flex;gap:2px}
  .rec .syms img{width:24px;height:24px;border-radius:6px;background:#fef0f5}
  .rec .nm{font-weight:700;font-size:12.5px}
  .rec .tag{margin-left:auto;font-size:11px;color:var(--muted)}
  .empty{font-size:12.5px;color:var(--muted);text-align:center;padding:10px 0}
  .rules{list-style:none;padding:0}
  .rules li{font-size:12.5px;color:var(--muted);margin:5px 0;padding-left:16px;line-height:1.55;position:relative}
  .rules li:before{content:"·";position:absolute;left:4px;color:var(--btn-pink);font-weight:900;font-size:16px}
  .pool-section{margin-top:6px}
  .pool-title{font-size:12px;font-weight:800;margin:6px 0 4px;padding-left:4px}
  .pool-title.win-t{color:var(--accent-dark)}
  .pool-title.lose-t{color:var(--muted)}
  .pool-list{display:flex;flex-wrap:wrap;gap:5px;padding-left:4px}
  .pool-tag{
    font-size:11px;padding:3px 9px;border-radius:10px;font-weight:600;
    background:#fef0f3;color:var(--accent-dark);border:1px solid #fad4dc
  }
  .pool-tag.lose-tag{background:#f5f3f6;color:#7a6a82;border:1px solid #e8e4ea}

  /* ===== MODAL ===== */
  .mask{position:fixed;inset:0;background:rgba(58,46,51,.5);display:none;align-items:center;justify-content:center;padding:20px;z-index:50}
  .mask.show{display:flex;animation:fade .25s}
  .modal{background:#fff;border-radius:24px;max-width:320px;width:100%;overflow:hidden;animation:pop .3s;position:relative}
  .modal-close{position:absolute;top:10px;right:12px;width:30px;height:30px;border:none;background:rgba(58,46,51,.06);border-radius:50%;color:#8a7a82;font-size:20px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;z-index:5;transition:.15s}
  .modal-close:active{transform:scale(.9);background:rgba(58,46,51,.12)}
  .share-modal{background:#fff;border-radius:24px;max-width:320px;width:100%;padding:24px 20px 20px;position:relative;animation:pop .3s}
  .share-modal .modal-close{top:12px;right:12px}
  .share-title{font-size:19px;font-weight:900;color:var(--accent-dark);text-align:center}
  .share-sub{font-size:12.5px;color:var(--muted);text-align:center;margin:6px 0 16px;line-height:1.5}
  .share-input{width:100%;border:1.5px solid var(--machine-border);border-radius:12px;padding:11px 12px;font-size:13px;color:var(--text);background:#fdf6f8;outline:none;margin-bottom:12px;-webkit-user-select:text;user-select:text}
  .share-copy{width:100%;padding:13px;border:none;border-radius:14px;background:linear-gradient(135deg,var(--btn-pink),var(--btn-pink-deep));color:#fff;font-size:16px;font-weight:800;cursor:pointer;box-shadow:0 5px 16px rgba(232,93,128,.25)}
  .share-copy:active{transform:scale(.97)}
  .share-copy.copied{background:linear-gradient(135deg,#5fce7e,#3fb068);box-shadow:0 5px 16px rgba(63,176,104,.3)}
  .share-tip{font-size:11.5px;color:var(--muted);text-align:center;margin-top:10px;line-height:1.5}
  @keyframes pop{from{transform:scale(.88);opacity:0}to{transform:scale(1);opacity:1}}
  .modal-head{padding:22px 18px 10px;text-align:center}
  .modal-head .big{font-size:24px;font-weight:900}
  .modal-head.win .big{color:var(--accent-dark)}
  .modal-head.lose .big{color:#8a7a82}
  .coupon{margin:4px 16px 0;background:linear-gradient(135deg,#ffe8ee,#ffd4e2);border-radius:16px;
    padding:16px;display:flex;align-items:center;gap:12px;position:relative}
  .coupon.lose{background:linear-gradient(135deg,#f3eff4,#ebe5f0)}
  .coupon:before,.coupon:after{content:"";position:absolute;width:14px;height:14px;border-radius:50%;background:#fff;top:50%;transform:translateY(-50%)}
  .coupon:before{left:-7px}.coupon:after{right:-7px}
  .coupon .ico{width:48px;height:48px;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;font-size:26px;box-shadow:0 3px 8px rgba(0,0,0,.08);flex-shrink:0}
  .coupon .ct{font-size:17px;font-weight:900;color:#c23a5e;line-height:1.2}
  .coupon.lose .ct{color:#7a6a82}
  .coupon .cs{font-size:11px;color:#a06a7a;margin-top:2px}
  .modal-foot{padding:14px 18px 20px}
  .modal-foot button{width:100%;padding:14px;border:none;border-radius:14px;
    background:linear-gradient(135deg,var(--accent),var(--accent-dark));color:#fff;font-size:16px;font-weight:800;cursor:pointer}
  .modal-foot .claimed{background:#eee;color:#999}

  /* toast */
  .toast{position:fixed;bottom:36px;left:50%;transform:translateX(-50%);background:rgba(58,46,51,.9);color:#fff;
    padding:10px 18px;border-radius:30px;font-size:13px;z-index:60;opacity:0;transition:.3s;pointer-events:none}
  .toast.show{opacity:1}

  /* decoration palm icon */
  .deco-palm{position:fixed;bottom:10px;left:10px;font-size:28px;opacity:.15;z-index:0;pointer-events:none}
  .float-dl{position:fixed;bottom:18px;right:18px;z-index:999;padding:10px 18px;border-radius:20px;font-size:13px;font-weight:700;color:#fff;background:linear-gradient(135deg,#f06a92,#e85d80);box-shadow:0 4px 16px rgba(232,93,128,.35);text-decoration:none;cursor:pointer;transition:.15s;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;border:none;display:inline-block;line-height:1.4}
  .float-dl:active{transform:scale(.93)}
</style>
</head>
<body>

<div id="app">

  <!-- ============ ENTRY SCREEN ============ -->
  <section id="screen-entry" class="screen active">
    <div class="entry-wrap">
      <img class="brand-logo" src="data:image/svg+xml;utf8,&lt;svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 80'&gt;&lt;text x='200' y='58' font-family='Times New Roman,Georgia,serif' font-size='52' font-weight='400' letter-spacing='8' text-anchor='middle' fill='%23e85d80'&gt;MOLLY TEA&lt;/text&gt;&lt;/svg&gt;" alt="MOLLY TEA">
      <div>
        <div class="entry-title" data-i18n="appTitle">欢喜摇摇乐</div>
        <div class="entry-sub" data-i18n="appSubtitle">摇一摇，好礼天天抽</div>
      </div>
      <div>
        <div class="lang-label" data-i18n="chooseLang">请选择语言</div>
        <div class="lang-row">
          <button class="lang-btn sel" data-lang="zh">中文</button>
          <button class="lang-btn" data-lang="en">English</button>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ LOGIN SCREEN ============ -->
  <section id="screen-login" class="screen">
    <div class="login-wrap">
      <div class="login-card">
        <img class="login-logo" src="data:image/svg+xml;utf8,&lt;svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 80'&gt;&lt;text x='200' y='58' font-family='Times New Roman,Georgia,serif' font-size='52' font-weight='400' letter-spacing='8' text-anchor='middle' fill='%23e85d80'&gt;MOLLY TEA&lt;/text&gt;&lt;/svg&gt;" alt="MOLLY TEA">
        <div class="login-title" data-i18n="loginTitle">手机号登录</div>
        <div class="login-sub" data-i18n="loginSub">验证后即可参与抽奖</div>
        <div class="field">
          <input id="phone" type="tel" inputmode="numeric" maxlength="11" placeholder="请输入手机号" data-i18n-ph="phonePlaceholder">
          <span class="code-btn" id="getCode" data-i18n="getCode">获取验证码</span>
        </div>
        <div class="field">
          <input id="code" type="tel" inputmode="numeric" maxlength="6" placeholder="请输入验证码" data-i18n-ph="codePlaceholder">
        </div>
        <button class="primary-btn" id="loginBtn" data-i18n="loginBtn">登录</button>
        <div class="dev-code" id="devCode" style="display:none"></div>
        <div class="hint" id="loginHint"></div>
      </div>
    </div>
  </section>

  <!-- ============ ACTIVITY SCREEN ============ -->
  <section id="screen-activity" class="screen">

    <!-- Header -->
    <div class="act-header">
      <div class="header-actions">
        <button id="langToggle" class="accent">EN</button>
        <button id="reloginBtn" data-i18n="reloginBtn">退出重登</button>
      </div>
      <div class="top-row">
        <img class="brand-svg" src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='150'%20height='30'%3E%3Ctext%20x='75'%20y='22'%20font-family='Times%20New%20Roman,Georgia,serif'%20font-size='20'%20letter-spacing='3'%20text-anchor='middle'%20fill='%23e85d80'%3EMOLLY%20TEA%3C/text%3E%3C/svg%3E" alt="MOLLY TEA">
      </div>
    </div>

    <!-- Quota bar (compact) -->
    <div class="quota-bar">
      <div class="quota-pill">
        <span data-i18n="quotaLabel">剩余</span>
        <span class="num" id="quotaNum">2</span>
        <span>次</span>
      </div>
      <span class="quota-info" id="quotaInfo" data-i18n="quotaInfo">免费2次/上限10次</span>
    </div>

    <!-- Slot Machine -->
    <div class="slot-area">
      <div class="slot-machine">
        <!-- decorative bulbs -->
        <div class="bulb gold b1"></div><div class="bulb white b2"></div><div class="bulb gold b3"></div><div class="bulb white b4"></div><div class="bulb gold b5"></div>
        <div class="bulb white b6"></div><div class="bulb gold b7"></div><div class="bulb white b8"></div><div class="bulb gold b9"></div><div class="bulb white b10"></div>
        <div class="bulb gold b11"></div><div class="bulb white b12"></div><div class="bulb gold b13"></div>
        <div class="bulb white b14"></div><div class="bulb gold b15"></div><div class="bulb white b16"></div>

        <div class="reels">
          <div class="reel" id="reel0"><div class="strip" id="strip0"></div></div>
          <div class="reel" id="reel1"><div class="strip" id="strip1"></div></div>
          <div class="reel" id="reel2"><div class="strip" id="strip2"></div></div>
        </div>
      </div>
    </div>

    <!-- Action buttons -->
    <div class="action-row">
      <div class="draw-wrap">
        <button class="btn-draw" id="drawBtn" data-i18n="drawBtn">开始抽奖</button>
        <span class="draw-badge" id="drawBadge">1次</span>
      </div>
      <button class="btn-secondary" id="shareBtn" data-i18n="shareBtn">好友助力+1次</button>
    </div>

    <div style="display:flex;gap:10px;width:100%;max-width:340px;margin:0 auto 12px">
      <button style="flex:1;padding:10px;border-radius:12px;border:1.5px solid var(--machine-border);background:#fff;color:var(--btn-pink-deep);font-weight:700;font-size:13px;cursor:pointer" id="assistBtn" data-i18n="simulateAssist">模拟助力 +1</button>
    </div>

    <!-- Records -->
    <div class="panel" id="recordsPanel">
      <h3>📜 <span data-i18n="records">今日记录</span></h3>
      <div id="recList"><div class="empty" data-i18n="noRecord">还没有抽奖记录</div></div>
    </div>

    <!-- Rules with prize pools -->
    <div class="panel" id="rulesPanel">
      <h3>📋 <span data-i18n="rules">活动规则</span></h3>
      <ul class="rules">
        <li data-i18n="rule1">每日免费 2 次摇臂机会</li>
        <li data-i18n="rule2">分享给好友并获助力，每次 +1 次</li>
        <li data-i18n="rule3">每日摇臂上限 10 次</li>
        <li data-i18n="rule4">三张卡片一致进入胜利奖池，否则进入失败奖池</li>
        <li data-i18n="rule5">中奖后点击「立即领取」跳转领取</li>
      </ul>
      <div class="pool-section">
        <div class="pool-title win-t" data-i18n="winPoolTitle">🏆 胜利奖池（三张一致）</div>
